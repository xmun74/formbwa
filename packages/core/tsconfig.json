{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // DOM 타입 제거 — core는 프레임워크·브라우저 무관 순수 TS (TRD-FE §5.1)
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
